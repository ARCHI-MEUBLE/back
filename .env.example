# =============================================================================
# ArchiMeuble Backend - Configuration
# =============================================================================
# Copiez ce fichier en .env et remplissez les valeurs.
# Commande: cp .env.example .env
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
# "production" active des comportements plus stricts (cookies Secure par défaut).
# Laisser vide ou "local" en développement.
APP_ENV=local

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Requis. Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://archimeuble:archimeuble_dev@localhost:5432/archimeuble

# =============================================================================
# FRONTEND / CORS
# =============================================================================
# URL du frontend Next.js, utilisée pour CORS et les liens dans les emails.
FRONTEND_URL=http://localhost:3000

# URL publique de ce backend (utilisée dans les emails, ex. lien de téléchargement DXF).
BACKEND_URL=http://127.0.0.1:8000

# Origines CORS additionnelles, séparées par des virgules.
# localhost:3000/3001 et *.vercel.app / *.archimeuble.com sont déjà autorisés.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_SUFFIXES=

# =============================================================================
# SESSION
# =============================================================================
# Cookie "Secure" forcé à true/false. Laisser vide pour auto-détection
# (Secure sauf sur localhost/127.0.0.1).
SESSION_SECURE=
# Durée avant régénération de l'ID de session, en secondes (défaut: 1800).
SESSION_REGENERATION_SECONDS=1800

# =============================================================================
# GÉNÉRATION 3D (Python)
# =============================================================================
# Exécutable Python. En local: python3. Dans Docker: /opt/venv/bin/python3.
PYTHON_PATH=python3
# Délai maximum d'exécution du script de génération, en secondes (défaut: 120).
PYTHON_TIMEOUT_SECONDS=120

# =============================================================================
# STOCKAGE (facultatif — défaut: /data en prod, storage/ en local)
# =============================================================================
MODELS_DIR=
UPLOADS_DIR=
TEXTURES_DIR=

# =============================================================================
# STRIPE (paiement)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_ici
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_ici
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret_ici

# =============================================================================
# RESEND (emails transactionnels)
# =============================================================================
RESEND_API_KEY=re_votre_cle_api_ici
# Email recevant les notifications admin (nouvelle commande, nouvelle config...).
ADMIN_EMAIL=pro.archimeuble@gmail.com

# =============================================================================
# CALENDLY
# =============================================================================
CALENDLY_API_TOKEN=votre-calendly-api-token-ici
CALENDLY_PHONE_URL=https://calendly.com/votre-nom/telephone
CALENDLY_VISIO_URL=https://calendly.com/votre-nom/visio

# =============================================================================
# CRISP (chat client)
# =============================================================================
CRISP_WEBSITE_ID=votre_crisp_website_id_ici

# =============================================================================
# TÂCHES PLANIFIÉES ET ENDPOINTS SYSTÈME
# =============================================================================
# Jeton pour déclencher les rappels Calendly et autres tâches cron via HTTP.
CRON_SECRET=votre_cron_secret_ici
# Clé partagée pour les endpoints système confidentiels (création admin, sauvegardes DB).
BACKUP_API_KEY=votre_backup_api_key_ici
