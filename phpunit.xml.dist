<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="test" force="false"/>
        <env name="TEST_DATABASE_URL" value="postgresql://archimeuble:archimeuble_dev@127.0.0.1:5432/archimeuble_test" force="false"/>
        <env name="TEST_SERVER_PORT" value="8089" force="false"/>
    </php>
</phpunit>
